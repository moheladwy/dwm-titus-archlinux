#!/usr/bin/python3
"""Run one validated Update Center provider operation in an interactive terminal."""
import codecs
import contextlib
import ctypes
import os
import re
import runpy
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import textwrap
import time
from pathlib import Path

CENTER_PATH = Path(__file__).resolve().with_name("dwm-update-center")
CENTER = runpy.run_path(str(CENTER_PATH))
PROVIDERS = tuple(entry.identifier for entry in CENTER["REGISTRY"])
OPERATION_PATTERN = re.compile(r"op-[0-9a-f]{32}")
TERMINAL_TITLE = "dwm update center"
TERMINAL_INSTANCE = b"dwm-update-center"
TERMINAL_CLASS = b"DwmUpdateCenter"
DEFAULT_TIMEOUT = 1800
validate_provider_action = CENTER["validate_provider_action"]


class XClassHint(ctypes.Structure):
    _fields_ = [("res_name", ctypes.c_char_p), ("res_class", ctypes.c_char_p)]


def set_terminal_identity(environment=None, output=None):
    """Apply the fixed Task 7 identity to this terminal; never include opaque tokens."""
    environment = os.environ if environment is None else environment
    destination = sys.stdout if output is None else output
    title = TERMINAL_TITLE + (" tiled" if environment.get("DWM_UPDATE_CENTER_WINDOW_MODE") == "tiled" else "")
    destination.write("\033]0;" + title + "\007")
    destination.flush()
    if environment.get("DWM_UPDATE_CENTER_TERMINAL_IDENTITY") == "1":
        return True
    display_name, raw_window = environment.get("DISPLAY"), environment.get("WINDOWID")
    if not display_name or not raw_window or not re.fullmatch(r"(?:0x[0-9A-Fa-f]+|[1-9][0-9]*)", raw_window):
        return False
    try:
        window = int(raw_window, 0)
        library = ctypes.CDLL("libX11.so.6")
        library.XOpenDisplay.argtypes = [ctypes.c_char_p]
        library.XOpenDisplay.restype = ctypes.c_void_p
        library.XStoreName.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_char_p]
        library.XSetClassHint.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(XClassHint)]
        library.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        library.XCloseDisplay.argtypes = [ctypes.c_void_p]
        display = library.XOpenDisplay(display_name.encode("utf-8"))
        if not display:
            return False
        try:
            hint = XClassHint(TERMINAL_INSTANCE, TERMINAL_CLASS)
            return bool(library.XStoreName(display, window, title.encode("utf-8"))
                        and library.XSetClassHint(display, window, ctypes.byref(hint))
                        and library.XSync(display, 0) == 0)
        finally:
            library.XCloseDisplay(display)
    except (OSError, ValueError, OverflowError):
        return False


PROVIDER_TITLES = {
    "system": ("Update system packages", "Recover system packages"),
    "aur": ("Update AUR packages", "Recover AUR packages"),
    "flatpak": ("Update Flatpak packages", "Recover Flatpak packages"),
    "dwm-titus": ("Update DWM-Titus", "Recover DWM-Titus"),
    "mise": ("Update mise tools", "Recover mise tools"),
}


def print_provider_header(provider, action, *, output=None):
    destination = sys.stdout if output is None else output
    pair = PROVIDER_TITLES.get(provider)
    if pair:
        title = pair[1] if action == "recover" else pair[0]
    else:
        title = f"{action.capitalize()} {provider}"
    destination.write(f"\033[32m\n{title}\033[0m\n")
    destination.flush()


def print_step(detail, *, output=None):
    destination = sys.stdout if output is None else output
    text = detail.rstrip(".")
    if not (text.endswith("completed") or text.endswith("complete")):
        text = text + "..."
    destination.write(f"\033[1;34m::\033[0m {text}\n")
    destination.flush()


def checkpoint(operation, phase, detail, *, output=None):
    print_step(detail, output=output)
    changes = {"phase": phase, "detail": detail}
    if phase != "recovering":
        changes["provider_phase"] = phase
    return CENTER["update_operation"](operation, **changes)


def executable(name):
    path = shutil.which(name)
    if path is None:
        raise FileNotFoundError(name + " is unavailable")
    return str(Path(path).resolve())


def trusted_desktop_helper():
    helper = CENTER["trusted_desktop_helper"]()
    if helper is None:
        raise PermissionError("Trusted installed desktop updater unavailable")
    return helper


def format_progress_record(line):
    """Render tab-separated helper output readably; plain text passes through."""
    return "  |  ".join(line.rstrip("\n").split("\t"))


def print_terminal_line(line, *, output=None, width=None):
    """Render machine fields readably without changing the retained payload."""
    destination = sys.stdout if output is None else output
    formatted = format_progress_record(line)
    if not formatted:
        return
    columns = shutil.get_terminal_size((102, 24)).columns - 2 if width is None else width
    for entry in formatted.splitlines():
        wrapped = textwrap.wrap(entry, width=max(40, columns), subsequent_indent="  ",
                                break_long_words=False, break_on_hyphens=False)
        destination.write("\n".join(wrapped or [""]) + "\n")
    destination.flush()


@contextlib.contextmanager
def termination_cleanup():
    """Unwind Python cleanup on terminal hangup and explicit termination."""
    previous = {}

    def terminate(signum, _frame):
        raise SystemExit(128 + signum)

    try:
        for signum in (signal.SIGHUP, signal.SIGTERM):
            previous[signum] = signal.signal(signum, terminate)
        yield
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


@contextlib.contextmanager
def bounded_process(argv, *, cwd=None, env=None):
    """Own helper descendants even if the terminal hangs up during a command."""
    with termination_cleanup():
        process = None
        try:
            process = subprocess.Popen(argv, cwd=cwd, env=env, stdin=None, stdout=subprocess.PIPE,
                                       stderr=None, bufsize=0, start_new_session=True)
            yield process
        finally:
            # A second hangup must not interrupt cleanup of the owned group.
            for signum in (signal.SIGHUP, signal.SIGTERM):
                signal.signal(signum, signal.SIG_IGN)
            if process is not None:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
                process.stdout.close()


def stream_process(argv, *, cwd=None, env=None, timeout=DEFAULT_TIMEOUT, stream=True):
    """Execute argv, streaming decoded lines bounded by size and deadline."""
    if not isinstance(argv, list) or not argv or any(not isinstance(value, str) for value in argv):
        raise ValueError("invalid provider argv")
    if not isinstance(timeout, (int, float)) or timeout <= 0:
        raise ValueError("invalid timeout")
    with bounded_process(argv, cwd=cwd, env=env) as process:
        output, size = [], 0
        buffer = ""
        decoder = codecs.getincrementaldecoder("utf-8")(errors="strict")
        deadline = time.monotonic() + timeout
        with selectors.DefaultSelector() as selector:
            os.set_blocking(process.stdout.fileno(), False)
            selector.register(process.stdout, selectors.EVENT_READ)
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TimeoutError("command timed out")
                events = selector.select(remaining)
                if not events:
                    raise TimeoutError("command timed out")
                for key, _ in events:
                    try:
                        chunk = os.read(key.fileobj.fileno(), 65536)
                    except (BlockingIOError, InterruptedError):
                        continue
                    if not chunk:
                        selector.unregister(key.fileobj)
                        continue
                    size += len(chunk)
                    if size > CENTER["MAX_BYTES"]:
                        raise ValueError("provider output exceeded byte limit")
                    buffer += decoder.decode(chunk)
                    while "\n" in buffer:
                        line, buffer = buffer.split("\n", 1)
                        line_with_nl = line + "\n"
                        output.append(line_with_nl)
                        if stream:
                            print_terminal_line(line_with_nl)
            buffer += decoder.decode(b"", final=True)
            if buffer:
                output.append(buffer)
                if stream:
                    print_terminal_line(buffer)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("command timed out")
            try:
                status = process.wait(timeout=remaining)
            except subprocess.TimeoutExpired as error:
                raise TimeoutError("command timed out") from error
            return status, "".join(output)


def run_command(argv, *, cwd=None, env=None, timeout=DEFAULT_TIMEOUT, stream=True):
    """Stream bounded output while retaining the machine response for reconciliation."""
    status, payload = stream_process(argv, cwd=cwd, env=env, timeout=timeout, stream=stream)
    if status:
        raise subprocess.CalledProcessError(status, argv, payload)
    return payload


def result(outcome, phase, detail, restart="none", hold=True):
    detail = detail.encode("utf-8")[:8192].decode("utf-8", errors="ignore")
    return {"outcome": outcome, "phase": phase, "detail": detail, "restart": restart, "hold": hold}


def trusted_native_command(path):
    """Validate every directory and symlink hop of a fixed system executable."""
    if path not in {"/usr/bin/pacman", "/usr/bin/sudo"}:
        raise PermissionError("Native command is not allowlisted")
    root = os.lstat("/")
    if root.st_uid != 0 or root.st_mode & 0o022 or not stat.S_ISDIR(root.st_mode):
        raise PermissionError("Native command root directory is untrusted")
    pending = list(Path(path).parts[1:])
    current = Path("/")
    links = 0
    while pending:
        component = pending.pop(0)
        if component in {"", "."}:
            continue
        if component == "..":
            current = current.parent
            continue
        current /= component
        metadata = os.lstat(current)
        if metadata.st_uid != 0:
            raise PermissionError("Native command path must be root-owned: " + str(current))
        if stat.S_ISLNK(metadata.st_mode):
            links += 1
            if links > 40:
                raise PermissionError("Native command symlink chain is too long")
            target = Path(os.readlink(current))
            if target.is_absolute():
                current = Path("/")
                pending = list(target.parts[1:]) + pending
            else:
                current = current.parent
                pending = list(target.parts) + pending
            continue
        if metadata.st_mode & 0o022:
            raise PermissionError("Native command path must not be writable: " + str(current))
        if pending and not stat.S_ISDIR(metadata.st_mode):
            raise PermissionError("Native command parent is not a directory")
    if not stat.S_ISREG(os.stat(current).st_mode) or not os.access(current, os.X_OK):
        raise PermissionError("Native command is not executable")
    return str(current)


PACMAN_LOCK = Path("/var/lib/pacman/db.lck")
LOCK_GUIDANCE = ("The pacman database is locked (" + str(PACMAN_LOCK) + "): another package manager is "
                 "running. Wait for it to finish, then retry. To see which process holds the lock, run "
                 "'sudo fuser -v " + str(PACMAN_LOCK) + "'. Update Center never deletes the lock.")
NEWS_URL = "https://archlinux.org/feeds/news/"
NEWS_PAGE = "https://archlinux.org/news/"
NEWS_BYTES = 1024 * 1024
NEWS_TIMEOUT = 15
NEWS_ITEMS = 50


def pacman_lock_held():
    return os.path.lexists(PACMAN_LOCK)


def terminal_text(value, limit=240):
    """Strip control characters so remote text cannot drive the terminal."""
    text = " ".join("".join(char if ord(char) >= 32 and not 127 <= ord(char) <= 159 else " "
                            for char in value).split())
    return text[:limit]


def confirm(prompt, *, input_stream=None, output=None):
    """Explicit opt-in: only y or yes continues; EOF and anything else decline."""
    stream = sys.stdin if input_stream is None else input_stream
    destination = sys.stdout if output is None else output
    destination.write(prompt)
    destination.flush()
    try:
        if input_stream is None and stream.isatty():
            # Read the TTY line directly so Python's stdin buffer cannot hold
            # type-ahead that pacman's own prompts should receive.
            answer = os.read(stream.fileno(), 4096).decode("utf-8", errors="replace")
        else:
            answer = stream.readline()
    except (OSError, ValueError):
        answer = ""
    if not answer.endswith("\n"):
        destination.write("\n")
        destination.flush()
    return answer.strip().lower() in {"y", "yes"}


def fetch_news():
    return CENTER["fetch_https"](NEWS_URL, limit=NEWS_BYTES, timeout=NEWS_TIMEOUT)


def parse_news(payload):
    """Parse the Arch news RSS feed; DTDs and entities are rejected outright."""
    import email.utils
    import xml.etree.ElementTree as ElementTree
    if not isinstance(payload, bytes) or len(payload) > NEWS_BYTES:
        raise ValueError("news feed exceeded its size limit")
    # Decode first so another encoding cannot hide a declaration from the check.
    text = payload.decode("utf-8")
    lowered = text.lower()
    if "<!doctype" in lowered or "<!entity" in lowered:
        raise ValueError("news feed declares a DTD or entity")
    root = ElementTree.fromstring(text)
    channel = root.find("channel") if root.tag == "rss" else None
    if channel is None:
        raise ValueError("news feed is not RSS")
    items = []
    for entry in channel.findall("item")[:NEWS_ITEMS]:
        title = terminal_text(entry.findtext("title") or "")
        link = terminal_text(entry.findtext("link") or "", 512)
        try:
            published = email.utils.parsedate_to_datetime(entry.findtext("pubDate") or "")
            stamp = int(published.timestamp())
        except (TypeError, ValueError, OverflowError):
            continue
        if not title or not 0 < stamp <= (1 << 53):
            continue
        if not link.startswith("https://archlinux.org/"):
            link = NEWS_PAGE
        items.append((stamp, title, link))
    return sorted(items, reverse=True)


def news_preflight(*, input_stream=None, output=None):
    """D9: show unacknowledged Arch news and require an explicit Continue."""
    destination = sys.stdout if output is None else output
    print_step("Checking Arch Linux news before upgrading", output=destination)
    acknowledged = CENTER["read_news_ack"]()
    try:
        items = parse_news(fetch_news())
    except Exception as error:  # Any parser or network fault degrades to unavailable.
        destination.write("Arch Linux news is unavailable (" + terminal_text(str(error), 160) + "). "
                          "Read " + NEWS_PAGE + " before continuing.\n")
        return confirm("Continue with the system upgrade? [y/N] ", input_stream=input_stream, output=destination)
    unread = [item for item in items if item[0] > acknowledged]
    if not unread:
        destination.write("No unread Arch Linux news.\n")
        destination.flush()
        return True
    destination.write("\n\033[1;33mUnread Arch Linux news\033[0m (some items require manual action "
                      "before or after upgrading):\n")
    for stamp, title, link in unread:
        day = time.strftime("%Y-%m-%d", time.gmtime(stamp))
        destination.write(f"  {day}  {title}\n            {link}\n")
    destination.write("\n")
    if not confirm("Continue with the system upgrade? [y/N] ", input_stream=input_stream, output=destination):
        return False
    try:
        CENTER["write_news_ack"](max(acknowledged, unread[0][0]))
    except (OSError, ValueError) as error:
        destination.write("Warning: the news acknowledgement could not be saved: " + terminal_text(str(error)) + "\n")
    return True


def previous_result(operation):
    receipt = CENTER["active_operation"]()
    if receipt is None or receipt["operation"] != operation:
        raise ValueError("recovery does not own the active reservation")
    return terminal_text(receipt["detail"], 1024)


def review_recovery(operation, program, command, *, input_stream=None, output=None):
    destination = sys.stdout if output is None else output
    destination.write(previous_result(operation) + "\n")
    destination.write("The previous outcome is unknown. " + program + " never rolls back a transaction; "
                      "review /var/log/pacman.log for what was applied.\n")
    return confirm("Start a fresh interactive '" + command + "' now? [y/N] ",
                   input_stream=input_stream, output=destination)


def execute_system(operation, action, *, input_stream=None, output=None):
    """Run the interactive native upgrade; pacman owns every prompt."""
    destination = sys.stdout if output is None else output
    if action == "recover" and not review_recovery(operation, "pacman", "sudo pacman -Syu",
                                                   input_stream=input_stream, output=destination):
        return result("unknown", "failed", "Recovery reviewed; no new upgrade was started. "
                      "The previous system update outcome remains unknown.", "unknown")
    checkpoint(operation, "preparing", "Checking the pacman database lock", output=destination)
    if pacman_lock_held():
        return result("failed", "failed", LOCK_GUIDANCE, "unknown")
    if not news_preflight(input_stream=input_stream, output=destination):
        return result("failed", "failed", "System upgrade canceled before pacman started; no packages were changed.",
                      "unknown")
    try:
        sudo = trusted_native_command("/usr/bin/sudo")
        pacman = trusted_native_command("/usr/bin/pacman")
    except FileNotFoundError as error:
        return result("failed", "failed", "Required command is missing (" + str(error.filename or error) +
                      "). Install sudo and configure it for your user, then retry.", "unknown")
    print_step("Starting pacman; review its transaction and prompts below", output=destination)
    CENTER["update_operation"](operation, phase="system-executing", provider_phase="system-native",
                               detail="pacman owns the terminal")
    # Inherit all three terminal descriptors: pacman keeps its native output,
    # replacement/conflict/provider prompts, and confirmation. No output cap or
    # timeout may kill the frontend while privileged work continues.
    status = subprocess.call([sudo, "--", pacman, "-Syu"], cwd="/")
    if status < 0:
        return result("unknown", "interrupted", "pacman was interrupted; review its output and "
                      "/var/log/pacman.log before retrying.", "unknown")
    if status:
        detail = ("pacman exited with status " + str(status) + "; review its output. Closing this terminal "
                  "releases the reservation; no successful transaction is claimed.")
        if pacman_lock_held():
            detail += " " + LOCK_GUIDANCE
        return result("unknown", "failed", detail, "unknown")
    return result("succeeded", "completed", "pacman completed the system upgrade; review its output for "
                  ".pacnew files and restart guidance.", "unknown")


AUR_ROOT_REFUSAL = "AUR helpers never run as root, under sudo, or under pkexec; run Update Center as your user"


AUR_PENDING_REFUSAL = ("Update system packages first with sudo pacman -Syu; AUR packages must build "
                       "against a fully upgraded system")


def system_updates_pending():
    """Report pending repository updates; packages held by IgnorePkg never block."""
    # pacman -Qu exits 1 with no output when nothing is pending. It reads the
    # local sync databases only and never refreshes them.
    completed = subprocess.run(["/usr/bin/pacman", "-Qu"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, text=True, timeout=60, check=False)
    if completed.returncode not in (0, 1):
        raise RuntimeError("Could not read pending system updates; run sudo pacman -Syu before the AUR update")
    return any(line.strip() and not line.rstrip().endswith("[ignored]")
               for line in (completed.stdout or "").splitlines())


def execute_aur(operation, action, *, input_stream=None, output=None):
    """Run the existing AUR helper as the invoking user, never as root."""
    destination = sys.stdout if output is None else output
    if os.geteuid() == 0:
        raise PermissionError(AUR_ROOT_REFUSAL)
    helper = CENTER["aur_helper"]()
    if helper is None:
        raise FileNotFoundError("No AUR helper (paru or yay) is installed; dwm-titus never installs one")
    name = Path(helper).name
    if action == "recover" and not review_recovery(operation, name, name + " -Sua",
                                                   input_stream=input_stream, output=destination):
        return result("unknown", "failed", "Recovery reviewed; no new AUR upgrade was started. "
                      "The previous AUR update outcome remains unknown.")
    # Building AUR packages, or letting the helper install repository
    # dependencies, while system updates are pending is a partial upgrade.
    try:
        pending = system_updates_pending()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print_step(str(error), output=destination)
        return result("failed", "failed", str(error))
    if pending:
        print_step(AUR_PENDING_REFUSAL, output=destination)
        return result("failed", "failed", AUR_PENDING_REFUSAL + ". No AUR upgrade was started.")
    print_step("Starting " + name + " -Sua as your user; review its prompts below", output=destination)
    CENTER["update_operation"](operation, phase="aur-executing", provider_phase="aur-helper",
                               detail=name + " owns the terminal")
    status = subprocess.call([helper, "-Sua"], cwd=str(Path.home()))
    if status < 0:
        return result("unknown", "interrupted", name + " was interrupted; review its output before retrying.")
    if status:
        return result("unknown", "failed", name + " exited with status " + str(status) +
                      "; review its output. No successful AUR upgrade is claimed.")
    return result("succeeded", "completed", name + " completed the AUR upgrade; review its output.")


def desktop_value(payload):
    value = CENTER["machine_json"](payload)
    if not isinstance(value, dict) or not isinstance(value.get("state"), str):
        raise ValueError("invalid desktop updater state")
    return value


class DesktopStatusFormatter:
    def __init__(self, *, output=None):
        self.destination = sys.stdout if output is None else output
        self.last_base = None
        self.dot_count = 0

    def update(self, detail, percent=-1):
        if percent is not None and int(percent) >= 0:
            pct = int(percent)
            base = re.sub(r"\s*\[.*\]$", "", detail).strip()
            if base != self.last_base:
                if self.last_base is not None:
                    self.destination.write("\n")
                self.last_base = base
            self.destination.write(f"\r\033[K{base} \033[32m[{pct:>3}%]\033[0m")
            self.destination.flush()
            return

        base = detail.rstrip(". ")
        if base != self.last_base:
            if self.last_base is not None:
                self.destination.write("\n")
            self.dot_count = 1
            self.last_base = base
        else:
            self.dot_count = (self.dot_count % 5) + 1
        dots = " " + " ".join(["."] * (self.dot_count - 1)) if self.dot_count > 1 else ""
        self.destination.write(f"\r\033[K{base}.{dots}")
        self.destination.flush()

    def close(self):
        if self.last_base is not None:
            self.destination.write("\n")
            self.destination.flush()


def execute_desktop(operation, action, *, output=None):
    destination = sys.stdout if output is None else output
    helper = trusted_desktop_helper()
    status = desktop_value(run_command([helper, "status"], stream=False))
    if action == "recover":
        if status["state"] == "interrupted":
            desktop_operation = status.get("operation")
            if not isinstance(desktop_operation, str) or not re.fullmatch(r"[0-9a-f]{32}", desktop_operation):
                raise ValueError("desktop recovery identity unavailable")
            checkpoint(operation, "recovering", "Recovering the trusted desktop update", output=destination)
            terminal = desktop_value(run_command([helper, "recover", desktop_operation], stream=False))
        elif status["state"] in {"available", "drift", "current", "complete", "restart-required"}:
            return result("succeeded", "completed",
                          "Desktop update is already recovered: " + status.get("detail", "Ready"),
                          status.get("restart", "none"))
        else:
            # Closing a terminal does not stop the independent desktop worker.
            checkpoint(operation, "recovering", "Reattaching to the trusted desktop update", output=destination)
            terminal = status
    else:
        checked = desktop_value(run_command([helper, "check"], stream=False))
        revision = checked.get("available")
        if not isinstance(revision, str) or not re.fullmatch(r"[0-9a-f]{40}", revision):
            raise ValueError("verified desktop revision unavailable")
        checkpoint(operation, "desktop-starting", "Starting the trusted desktop update", output=destination)
        terminal = desktop_value(run_command([helper, "start", revision], stream=False))
    reconciled = desktop_value(run_command([helper, "status"], stream=False)) if action == "update" else terminal
    deadline = time.monotonic() + 1800
    formatter = DesktopStatusFormatter(output=destination)
    try:
        while reconciled["state"] in CENTER["DESKTOP_ACTIVE"] | {"checking"}:
            if time.monotonic() >= deadline:
                return result("unknown", "interrupted", "Desktop updater remains active; reconnect with recovery")
            formatter.update(reconciled.get("detail", "Desktop update running"), percent=reconciled.get("percent", -1))
            time.sleep(1)
            reconciled = desktop_value(run_command([helper, "status"], stream=False))
    finally:
        formatter.close()
    state = reconciled["state"]
    restart = reconciled.get("restart", "none")
    if state in {"current", "complete", "restart-required"} or (action == "recover" and "Previous desktop files restored" in reconciled.get("detail", "")):
        return result("succeeded", "completed", reconciled.get("detail", "Desktop update complete"), restart)
    if state == "interrupted":
        return result("unknown", "interrupted", reconciled.get("detail", "Desktop recovery required"), restart)
    return result("failed", "failed", reconciled.get("detail", "Desktop update failed"), restart)


def scan_flatpak_scope(program, scope):
    run_command([program, "list", "--" + scope, "--columns=ref:full,version"], stream=False)
    run_command([program, "remote-ls", "--" + scope, "--updates", "--columns=ref:full,version"], stream=False)


def flatpak_recovery_basis(operation):
    value = CENTER["read_operation"]()
    if (value is None or value["operation"] != operation or value["provider"] != "flatpak"
            or value["action"] != "recover" or not value["recovery_of"]):
        raise ValueError("Flatpak recovery provenance is unavailable")
    return value["recovery_phase"], value["recovery_provider_phase"]


def execute_flatpak(operation, action):
    program = executable("flatpak")
    if action == "recover":
        recovery_phase, provider_phase = flatpak_recovery_basis(operation)
        checkpoint(operation, "recovering", "Rechecking Flatpak system and user scopes")
        scan_flatpak_scope(program, "system")
        scan_flatpak_scope(program, "user")
        system_complete = recovery_phase == "system-complete/user-failed" or provider_phase in {
            "flatpak-system-complete", "flatpak-user", "flatpak-user-complete"}
        user_complete = provider_phase == "flatpak-user-complete"
        if not system_complete:
            checkpoint(operation, "flatpak-system", "Idempotently retrying the system Flatpak scope")
            run_command([program, "update", "--system", "--noninteractive"])
            checkpoint(operation, "flatpak-system-complete", "System Flatpak scope is complete")
        if not user_complete:
            checkpoint(operation, "flatpak-user", "Idempotently retrying the user Flatpak scope")
            run_command([program, "update", "--user", "--noninteractive"])
            checkpoint(operation, "flatpak-user-complete", "User Flatpak scope is complete")
        checkpoint(operation, "recovering", "Rechecking Flatpak scopes after recovery")
        scan_flatpak_scope(program, "system")
        scan_flatpak_scope(program, "user")
        return result("succeeded", "completed",
                      "Flatpak scopes were rechecked and safely retried; known completed system work was preserved")
    try:
        checkpoint(operation, "flatpak-system", "Updating system Flatpaks")
        run_command([program, "update", "--system", "--noninteractive"])
    except subprocess.CalledProcessError as error:
        return result("failed", "system-failed", "System Flatpak update failed; user scope was not started: " + str(error))
    try:
        checkpoint(operation, "flatpak-system-complete", "System Flatpak update completed")
        checkpoint(operation, "flatpak-user", "Updating user Flatpaks")
        run_command([program, "update", "--user", "--noninteractive"])
    except subprocess.CalledProcessError as error:
        return result("failed", "system-complete/user-failed",
                      "System scope remains complete; user Flatpak update failed: " + str(error))
    checkpoint(operation, "flatpak-user-complete", "User Flatpak update completed")
    return result("succeeded", "completed", "System and user Flatpak scopes completed")


def managed_mise(program):
    payload = run_command([program, "ls", "--current", "--installed", "--json"], cwd="/", env=dict(os.environ), stream=False)
    return CENTER["mise_inventory"](payload)


def execute_mise(operation, action):
    program = executable("mise")
    checkpoint(operation, "mise-inventory", "Reading Mise managed inventory")
    inventory = managed_mise(program)
    if action == "recover":
        checkpoint(operation, "recovering", "Retrying from the current Mise managed inventory")
    if inventory:
        checkpoint(operation, "mise-update", "Updating Mise managed tools")
        run_command([program, "upgrade", "--", *sorted({name for name, _ in inventory})],
                    cwd="/", env=dict(os.environ))
    checkpoint(operation, "mise-recheck", "Rechecking Mise managed inventory")
    managed_mise(program)
    return result("succeeded", "completed", "Mise managed inventory was rechecked after update")


def execute_provider(operation, provider, action):
    if not OPERATION_PATTERN.fullmatch(operation) or provider not in PROVIDERS or action not in {"update", "recover"}:
        raise ValueError("invalid terminal operation")
    # The launcher already ran full system discovery before reserving. pacman
    # computes its own fresh plan, so repeating discovery would only delay it.
    if provider == "aur" and os.geteuid() == 0:
        return result("failed", "failed", AUR_ROOT_REFUSAL)
    if provider != "system":
        validate_provider_action(provider, action)
    return {"system": execute_system, "aur": execute_aur, "dwm-titus": execute_desktop,
            "flatpak": execute_flatpak, "mise": execute_mise}[provider](operation, action)


def format_completion_banner(value):
    detail = value.get("detail", "Operation finished")
    if value.get("outcome") == "unknown":
        return f"\n\033[1;33m==> OUTCOME UNKNOWN:\033[0m {detail}\n"
    if detail == "Desktop update installed, verified, and active.":
        return "\n\033[1;32mUpdate Installed Successfully!\033[0m\n"
    if "Restart required, or Log out and back in" in detail or detail == "Installed and verified. Log out and back in to activate the updated desktop.":
        return "\n\033[1;32mUpdate Installed Successfully! \033[1;33mRestart required, or Log out and back in for update to take effect.\033[0m\n"
    if "Quickshell did not respond" in detail or "Quickshell restart timed out" in detail:
        return "\n\033[1;33mUpdate Files Installed, but Quickshell restart timed out, \033[1;31mPlease Log out and back in.\033[0m\n"
    if "Previous desktop files restored" in detail or "Recovery completed" in detail:
        return "\n\033[1;32mRecovery completed, \033[1;31mPlease Log out and back in for recovery to take effect.\033[0m\n"
    if value.get("outcome") == "succeeded":
        return f"\n\033[1;32m==>\033[0m {detail}\n"
    return f"\n\033[1;31m==> ERROR:\033[0m {detail}\n"


def wait_for_key(stream):
    if getattr(stream, "isatty", lambda: False)():
        try:
            import termios
            import tty
            fd = stream.fileno()
            old = termios.tcgetattr(fd)
            try:
                tty.setcbreak(fd)
                stream.read(1)
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
        except (OSError, ValueError, ImportError):
            stream.read(1)
    else:
        try:
            stream.read(1)
        except OSError:
            pass


def completion_hold(value, *, input_stream=None, output=None):
    if value.get("hold") is False:
        return
    stream = sys.stdin if input_stream is None else input_stream
    destination = sys.stdout if output is None else output
    destination.write(format_completion_banner(value))
    destination.write("\n\033[32m● \033[0mDone! Press any key to close...")
    destination.flush()
    if input_stream is not None:
        stream.read(1)
    else:
        wait_for_key(stream)
    destination.write("\n")
    destination.flush()


def run_terminal(argv=None):
    args = sys.argv[1:] if argv is None else argv
    if len(args) != 3:
        print("usage: dwm-update-center-terminal OPERATION_ID PROVIDER update|recover", file=sys.stderr)
        return 2
    operation, provider, action = args
    try:
        if not set_terminal_identity():
            raise OSError("controlled terminal X11 identity is unavailable")
        active = CENTER["active_operation"]()
        if active is None or (active["operation"], active["provider"], active["action"]) != tuple(args):
            raise ValueError("terminal operation does not own the active reservation")
        # A recovery keeps the reserved last-known-result detail to report it.
        CENTER["update_operation"](operation, phase="running",
                                   **({} if action == "recover" else {"detail": "Provider operation running"}))
        print_provider_header(provider, action)
        try:
            value = execute_provider(operation, provider, action)
        except Exception as error:
            value = result("unknown", "interrupted", "Provider outcome requires recovery: " + str(error))
        CENTER["update_operation"](operation, phase=value["phase"], outcome=value["outcome"], detail=value["detail"])
        # The operation watcher refreshes after terminal exit. Show the result
        # and keypress prompt immediately, without another silent discovery.
        completion_hold(value)
        return 0 if value["outcome"] == "succeeded" else 1
    except (OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 1


def main(argv=None):
    # Preflight discovery has its own bounded subprocess cleanup. Keep it on
    # the same unwind path as mutation helpers when the terminal disappears.
    with termination_cleanup():
        return run_terminal(argv)


if __name__ == "__main__":
    raise SystemExit(main())
