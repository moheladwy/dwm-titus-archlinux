#!/bin/sh
set -eu

detail=
if [ "${DWM_TEST_MODE:-0}" = 1 ]; then
	detail=${DWM_TEST_QUICKSHELL_VERSION:-}
fi
if [ -z "$detail" ]; then
	command -v quickshell >/dev/null 2>&1 || {
		printf 'quickshell is not installed\n' >&2
		exit 1
	}
	detail=$(quickshell --version 2>/dev/null | sed -n '1p') || detail=
	if [ -z "$detail" ]; then
		printf 'unable to determine the Quickshell version\n' >&2
		exit 1
	fi
fi

version=$(printf '%s\n' "$detail" | grep -oE '[0-9]+([.][0-9]+){1,2}' | sed -n '1p')

# Arch ships Quickshell from extra as a rolling release. 0.3.x is the tested
# series; newer releases are accepted with a warning so an upgrade cannot
# lock the desktop out, but they have not been validated.
version_matches() {
	printf '%s\n' "$version" | awk -F. "{ major = \$1 + 0; minor = \$2 + 0; exit !($1) }"
}

if [ -n "$version" ] && version_matches 'major > 0 || minor >= 3'; then
	if version_matches 'major > 0 || minor > 3'; then
		printf 'warning: Quickshell %s is newer than the tested 0.3 series\n' "$version" >&2
	fi
	exit 0
fi

printf 'unsupported Quickshell version: %s\n' "${detail:-unknown}" >&2
exit 1
